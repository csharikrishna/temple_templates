{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/templates/",
      "permanent": false
    },
    {
      "source": "/templates",
      "destination": "/templates/",
      "permanent": true
    },
    {
      "source": "/templates/template_1",
      "destination": "/templates/template_1/",
      "permanent": true
    },
    {
      "source": "/templates/template_4",
      "destination": "/templates/template_4/",
      "permanent": true
    },
    {
      "source": "/templates/template_5",
      "destination": "/templates/template_5/",
      "permanent": true
    },
    {
      "source": "/template_1",
      "destination": "/templates/template_1/",
      "permanent": true
    },
    {
      "source": "/template_4",
      "destination": "/templates/template_4/",
      "permanent": true
    },
    {
      "source": "/template_5",
      "destination": "/templates/template_5/",
      "permanent": true
    },
    {
      "source": "/templates/template_2",
      "destination": "/templates/template_1/",
      "permanent": false
    },
    {
      "source": "/templates/template_2/",
      "destination": "/templates/template_1/",
      "permanent": false
    },
    {
      "source": "/templates/template_2/:path*",
      "destination": "/templates/template_1/",
      "permanent": false
    },
    {
      "source": "/templates/template_3",
      "destination": "/templates/template_4/",
      "permanent": false
    },
    {
      "source": "/templates/template_3/",
      "destination": "/templates/template_4/",
      "permanent": false
    },
    {
      "source": "/templates/template_3/:path*",
      "destination": "/templates/template_4/",
      "permanent": false
    },
    {
      "source": "/template_2",
      "destination": "/templates/template_1/",
      "permanent": false
    },
    {
      "source": "/template_2/:path*",
      "destination": "/templates/template_1/",
      "permanent": false
    },
    {
      "source": "/template_3",
      "destination": "/templates/template_4/",
      "permanent": false
    },
    {
      "source": "/template_3/:path*",
      "destination": "/templates/template_4/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/template_1/:path*",
      "destination": "/templates/template_1/:path*"
    },
    {
      "source": "/template_4/:path*",
      "destination": "/templates/template_4/:path*"
    },
    {
      "source": "/template_5/:path*",
      "destination": "/templates/template_5/:path*"
    },
    {
      "source": "/flagship",
      "destination": "/index.html"
    }
  ]
}
